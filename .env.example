# Copy to .env and adjust. Every variable is documented in README.md.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pingwell
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Lets you monitor localhost while developing. Keep false on a public server.
ALLOW_PRIVATE_TARGETS=true

# Optional: real email alerts (otherwise emails are logged)
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM=Pingwell <alerts@example.com>

# Optional: dead man's switch for the monitor itself (e.g. a healthchecks.io ping URL)
# HEARTBEAT_URL=https://hc-ping.com/your-uuid
